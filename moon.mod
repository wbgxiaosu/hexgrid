// hexgrid module configuration
name = "wbgxiaosu/hexgrid"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/wbgxiaosu/hexgrid"

license = "Apache-2.0"

keywords = [
  "hexagonal",
  "hex-grid",
  "hexagon",
  "geometry",
  "pathfinding",
  "field-of-view",
  "game",
  "wargame",
  "strategy",
  "coordinate-systems",
  "algorithms",
]

preferred_target = "wasm-gc"

description = "Hexagonal grid geometry foundation for MoonBit: axial/cube/offset coordinate systems, distance, lines, rings, spirals, rotation, shadowcasting field of view and A* pathfinding behind pure, deterministic APIs"
